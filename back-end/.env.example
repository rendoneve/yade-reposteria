# Copia este archivo como .env (en esta misma carpeta back-end) y llena los valores.
# Lo leen TODOS los servicios.

# Cadena de conexión de Neon (Dashboard > Connect). Pégala tal cual, con sslmode=require.
DATABASE_URL=

# Clave para firmar los tokens (la misma para todos los servicios). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Clave para llamadas entre servicios (distinta de JWT_SECRET)
INTERNAL_API_KEY=

# Primer administrador: servicio-auth lo crea al arrancar SOLO si no hay ningún usuario.
# Después de crearlo puedes borrar estas líneas.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
ADMIN_CORREO=

# Duración de la sesión en minutos
JWT_EXPIRE_MINUTES=

# Orígenes del front-end permitidos por el gateway (separados por coma)
CORS_ORIGINS=

# Bucket de imágenes (compatible con S3). Mientras S3_BUCKET esté vacío no se pueden subir imágenes.
# S3_ENDPOINT_URL: endpoint S3 del proveedor (vacío = AWS S3). S3_PUBLIC_URL: URL pública desde
# la que el navegador puede ver los archivos del bucket (sin "/" al final).
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
